# Backend
# NOTE: host port 5433 (not 5432) is used because another local project already binds 5432.
DATABASE_URL=postgresql+psycopg://meetings_manager:meetings_manager@localhost:5433/meetings_manager
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Geoapify — road routing, travel-time matrix, stop optimization and geocoding.
# Backend only: never prefix with NEXT_PUBLIC_ or reference it from the frontend.
GEOAPIFY_API_KEY=your_geoapify_api_key

# Geocoding/place-search provider: "geoapify" (recommended), "mapbox" or "google".
# Route planning uses Geoapify whenever GEOAPIFY_API_KEY is set, regardless of this value.
MAP_PROVIDER=geoapify
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_REAL_TOKEN
GOOGLE_MAPS_API_KEY=REPLACE_WITH_REAL_KEY

# Company addresses are verified when saved, and unverified ones are retried
# in the background every N minutes (0 disables), backing off per address:
# BASE_HOURS x 2^attempts between tries, giving up after MAX_ATTEMPTS.
LOCATION_SWEEP_INTERVAL_MINUTES=360
LOCATION_SWEEP_BATCH_SIZE=200
LOCATION_RETRY_MAX_ATTEMPTS=5
LOCATION_RETRY_BASE_HOURS=6

BACKEND_CORS_ORIGINS=http://localhost:3001
ENVIRONMENT=development
# Public URL of this API — only needed for inbound webhooks (Bigin instant updates).
PUBLIC_API_BASE_URL=

# ---------------------------------------------------------------- Zoho Bigin
# All backend-only. Create a "Self Client" in the Zoho API console and
# generate a refresh token with scopes:
#   ZohoBigin.modules.accounts.READ,ZohoBigin.modules.contacts.READ,ZohoBigin.notifications.ALL
# Leave blank to keep CRM Sync disconnected (the admin page says so).
BIGIN_CLIENT_ID=
BIGIN_CLIENT_SECRET=
BIGIN_REFRESH_TOKEN=
# Must match the org's data center (e.g. accounts.zoho.eu + www.zohoapis.eu).
BIGIN_ACCOUNTS_URL=https://accounts.zoho.com
BIGIN_API_DOMAIN=https://www.zohoapis.com
# Reconciliation interval in minutes (0 disables); instant updates also need PUBLIC_API_BASE_URL.
BIGIN_SYNC_INTERVAL_MINUTES=30
BIGIN_WEBHOOKS_ENABLED=true
# Optional: API name of a custom Companies field to show as CRM status (Bigin has no standard one).
BIGIN_ACCOUNT_STATUS_FIELD=

# --------------------------------------------------------- Business summaries
# The LLM only summarizes sources gathered from the company's own website + CRM.
SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SUMMARY_MODEL=claude-opus-5
RESEARCH_STALE_DAYS=90

# ------------------------------------------------ Recording & transcription
# assemblyai (recommended) | deepgram | openai | none — only the selected provider's key is required.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
RECORDING_MAX_UPLOAD_MB=500

# Recording storage: "s3" for any S3-compatible bucket (Railway Buckets, AWS S3, R2), "local" for development.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --------------------------------------------------------------- Quote Builder
# External tool linked from the sidebar (opens in a new tab). Served to signed-in
# users at runtime via /app-config — not a NEXT_PUBLIC_ build variable.
QUOTE_BUILDER_URL=

# Frontend
# NOTE: backend runs on 8001 and frontend dev server on 3001 (3000/8000 are taken by another local project).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=REPLACE_WITH_REAL_TOKEN
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_REAL_KEY
