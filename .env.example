# Backend
# NOTE: host port 5433 (not 5432) is used because another local project already binds 5432.
DATABASE_URL=postgresql+psycopg://meetings_manager:meetings_manager@localhost:5433/meetings_manager
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Map provider: "mapbox" (default, no credit card required) or "google"
MAP_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=REPLACE_WITH_REAL_TOKEN
GOOGLE_MAPS_API_KEY=REPLACE_WITH_REAL_KEY

BACKEND_CORS_ORIGINS=http://localhost:3001
ENVIRONMENT=development

# Frontend
# NOTE: backend runs on 8001 and frontend dev server on 3001 (3000/8000 are taken by another local project).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_MAP_PROVIDER=mapbox
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=REPLACE_WITH_REAL_TOKEN
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_REAL_KEY
